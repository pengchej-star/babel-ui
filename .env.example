# babel-ui settings. Copy to .env (install.sh does this) and edit; every line is optional.
# Variables already set in your shell take precedence over this file.

# ssh host alias from ~/.ssh/config (the `Host xxx` line)
BABEL_HOST=babel

# local port the panel listens on (only 127.0.0.1)
BABEL_UI_PORT=8765

# cluster name shown in the page title and desktop notifications
BABEL_UI_NAME=Babel

# how long the shared ssh connection stays open with nothing using it (ssh ControlPersist)
BABEL_UI_PERSIST=8h

# when auto-login (saved password) hits a Duo "Passcode or option" prompt, answer with this.
# At CMU 1 = Duo Push. Leave empty to never answer Duo automatically.
BABEL_UI_DUO_OPTION=1

# extra remote paths the file tab must never delete or move, colon-separated
# (top-level dirs, your home and /<anything>/$USER roots are always protected)
BABEL_UI_PROTECT=

# python interpreter; empty = .venv/bin/python if it exists, else python3
BABEL_UI_PYTHON=

# browser app for `babel-ui` (macOS app name, e.g. "Safari"); empty = Chrome if installed,
# else the system default; "none" = don't open a browser
BABEL_UI_BROWSER=
